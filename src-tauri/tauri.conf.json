{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syncwatch",
  "version": "0.4.2",
  "identifier": "com.opiiie.syncwatch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncWatch",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 800,
        "transparent": false,
        "backgroundColor": "#100e1c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjk4MjUxQkNGMzNBNTQKUldSVU92TzhVWUlwTHpRVG02L2FTb0tKakVwVTZQWjR6cStIK0k3MnpUYzhGVXFSeXY2b0xmQXEK",
      "endpoints": [
        "https://github.com/Opiiie/SyncWatch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
